<Window x:Class="DuplicateFileManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate File Manager" Height="800" Width="1280" MinHeight="620" MinWidth="960"
        Background="#F7F8F4" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style x:Key="SidebarButton" TargetType="Button"><Setter Property="Height" Value="42" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,0" /><Setter Property="Margin" Value="8,2" /><Setter Property="Foreground" Value="#C8D1CB" /><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="14" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#31413D" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#53645D" /></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#31413D" /><Setter Property="Foreground" Value="White" /><Setter Property="Padding" Value="8,6" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#465A54" /><Setter Property="Foreground" Value="White" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#647C51" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGrid"><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="CanUserResizeRows" Value="False" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="RowHeaderWidth" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="White" /><Setter Property="RowBackground" Value="White" /><Setter Property="AlternatingRowBackground" Value="#FBFCFA" /><Setter Property="HorizontalGridLinesBrush" Value="#E9EDE7" /><Setter Property="FontSize" Value="13" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1E2927">
            <Grid Margin="16,26,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,28"><Border Width="34" Height="34" Background="#D9EF71" CornerRadius="6" Margin="0,0,10,0"><TextBlock Text="DF" Foreground="#1E2927" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Duplicate&#x0a;Manager" Foreground="White" FontFamily="Georgia" FontSize="18" FontWeight="Bold" LineHeight="15" VerticalAlignment="Center" /></StackPanel>
                <Button Grid.Row="1" x:Name="ScanButton" Click="ScanButton_Click" Height="45" Background="#D9EF71" Foreground="#1E2927" FontWeight="Bold" FontSize="14" Content="Choose folder and scan" />
                <StackPanel Grid.Row="2" Margin="0,30,0,0"><TextBlock Text="LIBRARY" Foreground="#8F9B96" FontSize="10" FontWeight="Bold" Margin="12,0,0,8" /><Button Style="{StaticResource SidebarButton}" Background="#31413D" Foreground="White" Content="Duplicate files" /><Button Style="{StaticResource SidebarButton}" Content="Smart review" /><TextBlock Text="SCAN ROOT" Foreground="#8F9B96" FontSize="10" FontWeight="Bold" Margin="12,28,0,8" /><TextBlock x:Name="SidebarRootText" Text="No folder selected" Foreground="#BAC5BE" FontSize="12" TextWrapping="Wrap" Margin="12,0" /><TextBlock Text="NAMING PROTECTION" Foreground="#8F9B96" FontSize="10" FontWeight="Bold" Margin="12,24,0,8" /><ComboBox x:Name="NamingProviderSelector" SelectedValuePath="Tag" SelectionChanged="NamingProviderSelector_SelectionChanged" Margin="12,0" Padding="8,5" Background="#31413D" Foreground="White"><ComboBoxItem Content="Whisparr" Tag="Whisparr" /><ComboBoxItem Content="Radarr" Tag="Radarr" /><ComboBoxItem Content="Sonarr" Tag="Sonarr" /><ComboBoxItem Content="No naming protection" Tag="None" /></ComboBox><Button Style="{StaticResource SidebarButton}" Content="Settings" Click="SettingsButton_Click" Margin="8,22,8,2" /></StackPanel>
                <Border Grid.Row="4" BorderBrush="#3B4945" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="SCAN PRIVACY" Foreground="#8F9B96" FontSize="10" FontWeight="Bold" /><TextBlock Text="Files are processed locally." Foreground="#D7E0DA" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="54,42,54,28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="DUPLICATE FILES" Foreground="#728076" FontSize="10" FontWeight="Bold" /><TextBlock Text="Free up space, thoughtfully." Foreground="#1E2927" FontFamily="Georgia" FontSize="35" Margin="0,9,0,5" /><TextBlock Text="Select a root folder to find exact file matches without uploading anything." Foreground="#65716A" FontSize="14" /></StackPanel><Button x:Name="ChangeRootButton" Content="Change root folder" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="15,10" Background="White" BorderBrush="#DCE3DB" BorderThickness="1" Click="ScanButton_Click" /></Grid>
            <Border Grid.Row="1" Background="#EAF2DA" BorderBrush="#DCE8C6" BorderThickness="1" CornerRadius="7" Padding="22,18" Margin="0,34,0,28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="POTENTIAL SPACE TO RECLAIM" Foreground="#65705F" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="PotentialText" Text="0 B" Foreground="#26322D" FontFamily="Georgia" FontSize="25" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="1" Background="#CBD7B6" Margin="12,0" /><StackPanel Grid.Column="2"><TextBlock Text="DUPLICATE GROUPS FOUND" Foreground="#65705F" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="GroupCountText" Text="No scan yet" Foreground="#26322D" FontFamily="Georgia" FontSize="25" Margin="0,3,0,0" /></StackPanel></Grid></Border>
            <Grid Grid.Row="2" Margin="0,0,0,14"><StackPanel><TextBlock Text="Review duplicates" Foreground="#26322D" FontFamily="Georgia" FontSize="22" /><TextBlock x:Name="StatusText" Text="Choose a folder to begin." Foreground="#6D766F" FontSize="13" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><ProgressBar x:Name="ScanProgress" Height="5" Width="120" IsIndeterminate="True" Visibility="Collapsed" Foreground="#799B47" VerticalAlignment="Center" /><Button x:Name="StopScanButton" Content="Stop scan" Click="StopScanButton_Click" Padding="12,7" Margin="12,0,0,0" Background="#F7E3E0" Foreground="#9A3E34" Visibility="Collapsed" /></StackPanel></Grid>
            <DataGrid Grid.Row="3" x:Name="GroupsGrid" ItemsSource="{Binding DuplicateGroups}" SelectionMode="Single" IsReadOnly="False" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn Header="DUPLICATE GROUP" Binding="{Binding Name}" Width="*" IsReadOnly="True" /><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="130" IsReadOnly="True" /><DataGridTextColumn Header="COPIES" Binding="{Binding Copies}" Width="70" IsReadOnly="True" /><DataGridTextColumn Header="RECLAIM" Binding="{Binding Reclaim}" Width="105" IsReadOnly="True" /></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><DataGrid ItemsSource="{Binding Files}" Margin="18,0,18,12" IsReadOnly="False"><DataGrid.Columns><DataGridTemplateColumn Header="REMOVE" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="*" IsReadOnly="True" /><DataGridTextColumn Header="LOCATION" Binding="{Binding Directory}" Width="220" IsReadOnly="True" /><DataGridTextColumn Header="STATUS" Binding="{Binding ProtectionStatus}" Width="130" IsReadOnly="True" /><DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90" IsReadOnly="True" /><DataGridTextColumn Header="MODIFIED" Binding="{Binding ModifiedText}" Width="110" IsReadOnly="True" /></DataGrid.Columns></DataGrid></DataTemplate></DataGrid.RowDetailsTemplate><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="DetailsVisibility" Value="Visible" /></Style></DataGrid.RowStyle></DataGrid>
            <Border Grid.Row="4" BorderBrush="#DFE4DC" BorderThickness="0,1,0,0" Padding="0,19,0,0" Margin="0,14,0,0"><Grid><TextBlock Text="Files marked for removal are deleted permanently." Foreground="#6F786F" VerticalAlignment="Center" FontSize="13" /><Button x:Name="RemoveButton" Content="Remove selected" Padding="17,10" Background="#34473D" Foreground="White" HorizontalAlignment="Right" Click="RemoveButton_Click" /></Grid></Border>
        </Grid>
    </Grid>
</Window>
