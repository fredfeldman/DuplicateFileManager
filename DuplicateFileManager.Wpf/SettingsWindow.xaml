<Window x:Class="DuplicateFileManager.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="690" Height="430" MinWidth="620" MinHeight="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F8F4" FontFamily="Segoe UI">
    <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Settings" FontFamily="Georgia" FontSize="29" Foreground="#1E2927" /><TextBlock Text="Set the config.xml location for each naming-rule provider." Margin="0,7,0,0" Foreground="#647168" FontSize="13" /></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,28,0,24">
            <TextBlock Text="WHISPARR CONFIG.XML" Foreground="#6B786F" FontSize="10" FontWeight="Bold" /><Grid Margin="0,7,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions><TextBox x:Name="WhisparrPathTextBox" IsReadOnly="True" Padding="9,7" Background="White" BorderBrush="#D7DFD6" /><Button Grid.Column="1" Content="Browse" Tag="Whisparr" Click="BrowseButton_Click" Margin="8,0,0,0" Background="#E7EEE2" /><Button Grid.Column="2" Content="Reset" Tag="Whisparr" Click="ResetButton_Click" Margin="8,0,0,0" Background="Transparent" Foreground="#57685B" /></Grid>
            <TextBlock Text="RADARR CONFIG.XML" Foreground="#6B786F" FontSize="10" FontWeight="Bold" /><Grid Margin="0,7,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions><TextBox x:Name="RadarrPathTextBox" IsReadOnly="True" Padding="9,7" Background="White" BorderBrush="#D7DFD6" /><Button Grid.Column="1" Content="Browse" Tag="Radarr" Click="BrowseButton_Click" Margin="8,0,0,0" Background="#E7EEE2" /><Button Grid.Column="2" Content="Reset" Tag="Radarr" Click="ResetButton_Click" Margin="8,0,0,0" Background="Transparent" Foreground="#57685B" /></Grid>
            <TextBlock Text="SONARR CONFIG.XML" Foreground="#6B786F" FontSize="10" FontWeight="Bold" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions><TextBox x:Name="SonarrPathTextBox" IsReadOnly="True" Padding="9,7" Background="White" BorderBrush="#D7DFD6" /><Button Grid.Column="1" Content="Browse" Tag="Sonarr" Click="BrowseButton_Click" Margin="8,0,0,0" Background="#E7EEE2" /><Button Grid.Column="2" Content="Reset" Tag="Sonarr" Click="ResetButton_Click" Margin="8,0,0,0" Background="Transparent" Foreground="#57685B" /></Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Padding="18,9" Margin="0,0,9,0" Background="Transparent" Foreground="#54645A" /><Button Content="Save settings" Click="SaveButton_Click" Padding="18,9" Background="#34473D" Foreground="White" /></StackPanel>
    </Grid>
</Window>